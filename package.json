{
  "name": "scanhub",
  "version": "1.0.0",
  "private": true,
  "description": "Run SonarQube, Trivy, Semgrep, Gitleaks and more on every repo and keep all results in one place",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "e2e": "playwright test -c e2e/playwright.config.js",
    "e2e:report": "node e2e/open-report.js"
  },
  "dependencies": {
    "blakejs": "^1.2.1",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0"
  }
}
